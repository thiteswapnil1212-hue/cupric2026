# NEXT_PUBLIC_SUPABASE_* values are client-safe Supabase project configuration.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# GEMINI_API_KEY is server-only and must never use the NEXT_PUBLIC_ prefix.
GEMINI_API_KEY=

# Optional server-only Gemini model override.
GEMINI_MODEL=gemini-3.8-flash
